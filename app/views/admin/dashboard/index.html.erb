<h1>Admin Dashboard</h1>

<div class="dashboard-grid">

  <%= link_to admin_posts_path, class: "dashboard-card dashboard-card--clickable" do %>
    <h3>Total Posts</h3>
    <p><%= @posts_count %></p>
  <% end %>

  <div class="dashboard-card">
    <h3>Published</h3>
    <p><%= @published_posts %></p>
  </div>

  <div class="dashboard-card">
    <h3>Drafts</h3>
    <p><%= @draft_posts %></p>
  </div>

  <div class="dashboard-card">
    <h3>Users</h3>
    <p><%= @users_count %></p>
  </div>

  <div class="dashboard-card">
    <h3>Total Views</h3>
    <p><%= @total_views %></p>
  </div>

  <div class="dashboard-card">
    <h3>Site Visits (Total)</h3>
    <p><%= @total_visits %></p>
  </div>

  <div class="dashboard-card">
    <h3>Visits Today</h3>
    <p><%= @visits_today %></p>
  </div>

  <div class="dashboard-card">
    <h3>Visits This Week</h3>
    <p><%= @visits_this_week %></p>
  </div>

  <div class="dashboard-card">
    <h3>Visits This Month</h3>
    <p><%= @visits_this_month %></p>
  </div>

</div>


<section class="dashboard-panel">
  <h2>Visits per day <span class="dashboard-panel-note">last 30 days</span></h2>
  <%= render "visits_chart", visits_by_day: @visits_by_day %>
</section>

<div class="dashboard-panels">
  <%= render "ranked_list", title: "Top pages", note: "where visits start, last 30 days", rows: @top_pages %>
  <%= render "ranked_list", title: "Where visitors come from", note: "last 30 days", rows: @top_referrers %>
  <%= render "ranked_list", title: "Devices", note: "last 30 days", rows: @top_devices %>
  <%= render "ranked_list", title: "Browsers", note: "last 30 days", rows: @top_browsers %>
  <%= render "ranked_list", title: "Most-read posts", note: "all time",
             rows: @most_read_posts.map { |post| [ post.title, post.views_count, post_path(post) ] } %>
</div>
