<h1>Admin Dashboard</h1>

<div class="dashboard-grid">

  <%= link_to admin_posts_path, class: "dashboard-card dashboard-card--clickable" do %>
    <h3>Total Posts</h3>
    <p><%= @posts_count %></p>
  <% end %>

  <div class="dashboard-card">
    <h3>Published</h3>
    <p><%= @published_posts %></p>
  </div>

  <div class="dashboard-card">
    <h3>Drafts</h3>
    <p><%= @draft_posts %></p>
  </div>

  <div class="dashboard-card">
    <h3>Users</h3>
    <p><%= @users_count %></p>
  </div>

  <div class="dashboard-card">
    <h3>Total Views</h3>
    <p><%= @total_views %></p>
  </div>

  <div class="dashboard-card">
    <h3>Site Visits (Total)</h3>
    <p><%= @total_visits %></p>
  </div>

  <div class="dashboard-card">
    <h3>Visits Today</h3>
    <p><%= @visits_today %></p>
  </div>

  <div class="dashboard-card">
    <h3>Visits This Week</h3>
    <p><%= @visits_this_week %></p>
  </div>

  <div class="dashboard-card">
    <h3>Visits This Month</h3>
    <p><%= @visits_this_month %></p>
  </div>

</div>

