<h1>Posts</h1>

<table class="users-table">
  <thead>
    <tr>
      <th>Title</th>
      <th>Status</th>
      <th>Views</th>
      <th>Created</th>
    </tr>
  </thead>

  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= link_to post.title, post %></td>
        <td><%= post.status %></td>
        <td><%= post.views_count %></td>
        <td><%= post.created_at.strftime("%b %d, %Y") %></td>
      </tr>
    <% end %>
  </tbody>
</table>