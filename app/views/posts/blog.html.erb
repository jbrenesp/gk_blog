<div class="blog-grid">
  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <div class="blog-card">

        <% thumbnail = post.images.attached? ? post.images.first : post.preview_image %>
        <% if thumbnail %>
          <div class="post-thumbnail">
            <%= image_tag thumbnail.representation(resize_to_limit: [400, 300]), class: "post-thumbnail-img" %>
          </div>
        <% end %>

        <h3><%= link_to post.title, post %></h3>

        <p class="post-meta">
          <%= post.created_at.strftime("%b %d, %Y") %>
        </p>

        <p class="post-snippet">
          <%= truncate(strip_tags(post.plain_excerpt.to_s), length: 120) %>
        </p>

        <%= link_to "Read →", post, class: "read-more" %>
      </div>
    <% end %>
  <% else %>
    <p>No posts yet.</p>
  <% end %>
</div>